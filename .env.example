# Production / cloud: xAI Grok is used whenever a key is present.
XAI_API_KEY=
XAI_TEXT_MODEL=grok-4.6
XAI_IMAGE_MODEL=grok-imagine-image-quality

# Local-only fallback when no xAI key is set (Ollama on this machine)
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# LLM_TEXT_MODEL=qwen2.5vl:7b

# GPU box alternative (OpenAI-compatible vLLM) — only used when no XAI_API_KEY
# LLM_PROVIDER=vllm
# VLLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_TEXT_MODEL=Qwen/Qwen3-VL-8B-Instruct
# VLLM_API_KEY=

# Optional local stills when not using xAI: Automatic1111 or Forge with SDXL or Flux
# A1111_HOST=http://127.0.0.1:7860
# A1111_MODEL=
